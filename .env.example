# Realm Configuration
# Get your App ID from MongoDB Realm console
EXPO_PUBLIC_REALM_APP_ID=your_realm_app_id_here

# GraphQL Configuration
# Format: https://realm.mongodb.com/api/client/v2.0/app/<your-app-id>/graphql
EXPO_PUBLIC_GRAPHQL_ENDPOINT=https://your-realm-endpoint.mongodb.com/api/client/v2.0/app/your-app-id/graphql

# Backend URL (for image uploads)
EXPO_PUBLIC_BACKEND_URL=https://your-backend-url.com/api
