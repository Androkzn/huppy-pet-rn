  "devDependencies": {
    "babel-preset-react-app": "^10.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "CI=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "stop": "npx kill-port --port 3000",
    "sync": "aws s3 sync .build/ s3://huppyapp/ --profile huppy_dev --region us-west-2",
    "invalidate": "aws cloudfront create-invalidation --distribution-id E1CRWW9QIPV27 --paths '/*' --profile huppy_dev --region us-west-2",
    "publish": "npm run build && npm run sync && npm run invalidate"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
